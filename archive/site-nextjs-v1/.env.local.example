# ──────────────────────────────────────────────────────────────
# Giving Hand — Archived Next.js website: environment template
#
# This is a reference copy of the `.env.local` that this project
# used during development. To run the archived site:
#     cp .env.local.example .env.local
# then fill in your own values.
# ──────────────────────────────────────────────────────────────

# ── Supabase (client-side, exposed to the browser) ────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase service role key (SERVER-ONLY SECRET) ───────────
# Used by API routes under app/api/ for admin operations.
# ⚠️  This key BYPASSES Row Level Security. Never expose it to
#     the client, never commit a real value, never use the
#     NEXT_PUBLIC_ prefix for it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── SMTP email sending (lib/email.ts) ────────────────────────
# Credentials for an SMTP account used to send notifications.
# For Gmail, create an "App Password" at
# https://myaccount.google.com/apppasswords and use it below.
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password-or-app-password
EMAIL_FROM=noreply@givinghand.com

# ── Notes ────────────────────────────────────────────────────
# • `.env.local` is git-ignored by Next.js — keep real secrets
#   out of version control; only this template is committed.
